# Copy to .env and fill in real values. Placeholders only in this file.

# Image versions — pinned by tag and digest (ADR-002)
CAMUNDA_IMAGE=camunda/camunda:8.9.19
CAMUNDA_IMAGE_DIGEST=sha256:REPLACE_ME
CONNECTORS_IMAGE=camunda/connectors-bundle:8.9.10
CONNECTORS_IMAGE_DIGEST=sha256:REPLACE_ME
ELASTICSEARCH_IMAGE=docker.elastic.co/elasticsearch/elasticsearch:REPLACE_ME
ELASTICSEARCH_IMAGE_DIGEST=sha256:REPLACE_ME

# Orchestration Cluster admin (Basic auth)
CAMUNDA_ADMIN_USER=admin
CAMUNDA_ADMIN_PASSWORD=REPLACE_ME

# Anthropic Claude API (ADR-004; used from Phase 5)
ANTHROPIC_API_KEY=REPLACE_ME
