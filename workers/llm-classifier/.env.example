# Copy to .env and fill in. Used by the venv dev-fallback run; in compose the same
# variables come from infra/.env via the worker-llm-classifier service definition.
# The worker does not read .env itself: set -a; source .env; set +a
CAMUNDA_BASE_URL=http://localhost:8080
CAMUNDA_USER=admin
CAMUNDA_PASSWORD=REPLACE_ME

# Audit database (D5-3). Password must match POSTGRES_PASSWORD in infra/.env.
DATABASE_URL=postgresql://camunda:REPLACE_ME@localhost:5432/camunda_support

# LLM (aliases — the exact model id is recorded in the audit)
ANTHROPIC_API_KEY=REPLACE_ME
# Prompt files: /app/prompts in the container (compose mount); the venv run finds the
# repo's prompts/ automatically. Override with PROMPTS_DIR if needed.
LLM_MODEL_CLASSIFY=claude-haiku-4-5
LLM_MODEL_GENERATE=claude-sonnet-5
CLASSIFY_CONFIDENCE_THRESHOLD=0.8
CLASSIFY_PROMPT_VERSION=classify_v2
ANSWER_PROMPT_VERSION=answer_v1
NOTIFY_PROMPT_VERSION=notify_v1
