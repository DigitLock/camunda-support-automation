# Upgrade lab environment (copy to infra/upgrade-lab/.env.lab on the stand; git-ignored).
# Pinned one patch BEHIND the main stand so the patch upgrade can be rehearsed:
# 8.9.19 → 8.9.21 (8.9.20 was never published on Docker Hub, checked 2026-09-27).
CAMUNDA_VERSION=8.9.19
CAMUNDA_CONNECTORS_VERSION=8.9.10
ELASTIC_VERSION=8.19.11

CAMUNDA_ADMIN_PASSWORD=REPLACE_ME
CAMUNDA_CONNECTORS_PASSWORD=REPLACE_ME

# no integrations/workers/monitoring in the lab
COMPOSE_PROFILES=
STAND_IP=127.0.0.1
FX_BASE_URL=http://fx:8080
BOOKING_RETRY_BACKOFF=PT10S

# Compose interpolates every ${VAR:?} of the file at load time, also for services that are
# not started — placeholders keep the file loadable. None of these services run in the lab.
POSTGRES_USER=lab-unused
POSTGRES_PASSWORD=lab-unused
POSTGRES_DB=lab-unused
DATABASE_URL=postgresql://lab-unused:lab-unused@postgres:5432/lab-unused
ANTHROPIC_API_KEY=lab-unused
PROMETHEUS_VERSION=v3.15.0
GRAFANA_VERSION=13.2.2
GRAFANA_ADMIN_PASSWORD=lab-unused
