# Copy to infra/.env and fill in the placeholders. Compose reads .env from this directory.

## Image versions ## (variable names follow the official docker-compose-8.9 distribution)
CAMUNDA_VERSION=8.9.21
CAMUNDA_CONNECTORS_VERSION=8.9.12
ELASTIC_VERSION=8.19.11

## Orchestration Cluster users (Basic auth) ##
# Generate each password with: openssl rand -base64 24
CAMUNDA_ADMIN_PASSWORD=REPLACE_ME
CAMUNDA_CONNECTORS_PASSWORD=REPLACE_ME

## Phase 4 integrations ##
# VM address advertised on Kafka's EXTERNAL listener (host port 9092). Without it Kafka
# advertises 127.0.0.1: the stack still starts, but clients outside the VM cannot connect.
STAND_IP=REPLACE_ME
# FX gateway base URL for the REST connector (in-network address)
FX_BASE_URL=http://fx:8080

## Anthropic Claude API ## (ADR-004; used from Phase 5)
ANTHROPIC_API_KEY=REPLACE_ME
