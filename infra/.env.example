# Copy to infra/.env and fill in the placeholders. Compose reads .env from this directory.

## Image versions ## (variable names follow the official docker-compose-8.9 distribution)
CAMUNDA_VERSION=8.9.21
CAMUNDA_CONNECTORS_VERSION=8.9.12
ELASTIC_VERSION=8.19.11

## Orchestration Cluster users (Basic auth) ##
# Generate each password with: openssl rand -base64 24
CAMUNDA_ADMIN_PASSWORD=REPLACE_ME
CAMUNDA_CONNECTORS_PASSWORD=REPLACE_ME

## Phase 4 integrations ##
# Active compose profiles. Without this, any compose command on the VM (even
# `stop worker-booking`) fails with "no such service: booking-api", because the workers'
# depends_on points at a service from an inactive profile.
COMPOSE_PROFILES=integrations,workers,monitoring
# VM address advertised on Kafka's EXTERNAL listener (host port 9092). Without it Kafka
# advertises 127.0.0.1: the stack still starts, but clients outside the VM cannot connect.
STAND_IP=REPLACE_ME
# FX gateway base URL for the REST connector (in-network address)
FX_BASE_URL=http://fx:8080
# Booking worker: backoff between job retries after a booking-api 5xx / timeout /
# transport error (ISO 8601 duration, Phase 6.1). Optional; the compose default is PT10S.
BOOKING_RETRY_BACKOFF=PT10S

## PostgreSQL (LLM audit + analytics, Phase 5) ##
POSTGRES_USER=camunda
POSTGRES_PASSWORD=REPLACE_ME
POSTGRES_DB=camunda_support
# Worker connection string; the password must match POSTGRES_PASSWORD above
DATABASE_URL=postgresql://camunda:REPLACE_ME@postgres:5432/camunda_support

## LLM classifier (design D5-1; aliases — the exact model id lands in the audit table) ##
ANTHROPIC_API_KEY=REPLACE_ME
LLM_MODEL_CLASSIFY=claude-haiku-4-5
LLM_MODEL_GENERATE=claude-sonnet-5
CLASSIFY_CONFIDENCE_THRESHOLD=0.8
CLASSIFY_PROMPT_VERSION=classify_v2
ANSWER_PROMPT_VERSION=answer_v1
NOTIFY_PROMPT_VERSION=notify_v1

## Monitoring (Phase 6, design D6-1) ##
PROMETHEUS_VERSION=v3.15.0
GRAFANA_VERSION=13.2.2
# Grafana admin login (http://<stand>:3000); generate with: openssl rand -base64 24
GRAFANA_ADMIN_PASSWORD=REPLACE_ME
